# Optional. Without these the full observe/act/assert surface still works.

# Which API pays for the decision model. Every route speaks the same
# {model, state, questions} envelope -- only the URL, the model and whose
# credits pay change, so this is a choice and not a capability.
#
#   JEV_PROVIDER=typesafe     Jev's own API, paid for with TYPESAFE_API_KEY.
#                             This is the default.
#   JEV_PROVIDER=openrouter   The same model through OpenRouter's decisions
#                             route, paid for with OPENROUTER_API_KEY and no
#                             TypeSafe account needed.
#                             Model slugs that validate: jev-latest,
#                             typesafe/jev-1.13, ~typesafe/jev-latest.
#                             No :free variant exists, so OpenRouter needs a
#                             credits purchase (~$0.042/M input tokens,
#                             output not billed).
#   JEV_PROVIDER=perplexity   Perplexity's pplx-decider through its Decisions
#                             API, paid for with PERPLEXITY_API_KEY. Default
#                             model pplx-decider-latest (27B, $0.02/M input).
#                             Flash is not recommended: it answers each of a
#                             step's 5-8 questions separately and bills the
#                             page once per question. TYPE_TEXT needs its own
#                             TEXT_MODEL_API_KEY on this route.
#
# Leaving JEV_PROVIDER unset infers the provider from TYPESAFE_BASE_URL below,
# which is how this was configured before the variable had a name -- so a .env
# written earlier keeps working as written.
JEV_PROVIDER=typesafe

TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
# Blank picks the provider's own default: jev-latest, or pplx-decider-latest.
TYPESAFE_MODEL=

# A custom decisions endpoint -- a proxy, a staging host. It also names the
# provider when JEV_PROVIDER is unset.
# TYPESAFE_BASE_URL=https://openrouter.ai/api/alpha/decisions

# TYPE_TEXT while running browser_goal (turbo mode). Jev picks; it does not
# write prose, so a chat model fills the field. This whole block is optional
# and left unset on purpose: the helper then inherits the provider the decision
# model is already using, which needs no key of its own.
#
# Setting TEXT_MODEL_API_KEY -- or just TEXT_MODEL_BASE_URL -- is the explicit
# route and opts out of inheriting: the key, the URL and the model are then used
# as given, with TEXT_MODEL defaulting to deepseek-chat.
#
# Inheritance only works where the provider also serves a chat API -- that is
# OpenRouter, not Jev's own API, which answers typed questions and never writes
# prose. It also needs TEXT_MODEL named, because deepseek-chat is not an
# OpenRouter slug. Either way the key and the URL come from the same provider;
# borrowing a key across providers only earns a 401.
# TEXT_MODEL_API_KEY=
# TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
# TEXT_MODEL=deepseek-chat

# Browser
JEVMCP_HEADLESS=1
JEVMCP_FOREGROUND=0
# JEVMCP_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# JEVMCP_MODE=attach
# JEVMCP_CDP_URL=http://127.0.0.1:9222

# Policy envelope
# JEVMCP_ALLOW_DOMAINS=example.com,*.mycompany.com
# JEVMCP_DENY_DOMAINS=admin.example.com
JEVMCP_ALLOW_JS=0
JEVMCP_ALLOW_UPLOADS=1
JEVMCP_MAX_ACTIONS=250
JEVMCP_MAX_TEXT=6000
